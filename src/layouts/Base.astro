---
import '../styles/global.css';
import SmoothScroll from '../components/SmoothScroll';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${site.name} · AI Engineer`,
  description = 'AI engineer working across software, data and AI: retrieval systems, forecasting pipelines, cloud data workflows and agentic AI.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SmoothScroll client:load />
    <slot />
  </body>
</html>
