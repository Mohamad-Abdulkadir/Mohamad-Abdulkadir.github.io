---
import { about } from '../data/site';
import { skillGroups } from '../data/skills';
---

<section id="about" class="page shell">
  <h2 class="section-title mb-7 sm:mb-8">About</h2>

  <div class="grid items-start gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-14 xl:gap-20">
    <div>
      {
        about.paragraphs.map((p) => (
          <p class="mb-5 text-[clamp(1.02rem,1.5vw,1.12rem)] leading-relaxed text-fg/85">{p}</p>
        ))
      }

      <div class="mt-7 border-t border-line pt-6">
        <div class="eyebrow mb-4">Skills</div>
        <div class="flex flex-col gap-6">
          {
            skillGroups.map((g) => (
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
                <div class="shrink-0 text-[13px] leading-snug text-muted sm:w-36">{g.label}</div>
                <ul class="flex flex-wrap gap-x-2.5 gap-y-8">
                  {g.items.map((s) => (
                    <li class="skill" style={s.color ? `--brand:${s.color}` : undefined} tabindex="0" aria-label={s.name}>
                      <span class="skill-tile grid size-12 place-items-center rounded-xl border border-line bg-surface">
                        {s.emoji ? (
                          <span class="text-[1.4rem] leading-none" aria-hidden="true">
                            {s.emoji}
                          </span>
                        ) : s.stroke ? (
                          <svg viewBox={s.viewBox} class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={s.stroke} />
                          </svg>
                        ) : (
                          <svg viewBox={s.viewBox} class="size-6" fill="currentColor" fill-rule={s.evenodd ? 'evenodd' : undefined} aria-hidden="true">
                            <path d={s.path} />
                          </svg>
                        )}
                      </span>
                      <span class="skill-name" aria-hidden="true">{s.short ?? s.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-9">
      <div class="flex items-baseline justify-between gap-6">
        <div>
          <div class="eyebrow mb-1.5">Education</div>
          <p class="text-[15px] text-fg/90">{about.education.degree}, {about.education.school}</p>
          <p class="mt-0.5 text-[13.5px] font-semibold text-fg">{about.education.gpa}</p>
        </div>
        <span class="shrink-0 font-mono text-[12.5px] text-muted">{about.education.years}</span>
      </div>

      <div>
        <div class="mb-3.5 flex items-baseline justify-between gap-4">
          <div class="eyebrow">Publications</div>
          <a href={about.scholar} target="_blank" rel="noopener" class="about-link text-[13px]">
            Google Scholar <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ul class="flex flex-col gap-2">
          {
            about.publications.map((p) => (
              <li>
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="group flex items-start justify-between gap-4 rounded-xl border border-line px-4 py-3 transition-colors hover:border-fg/25 hover:bg-surface2"
                >
                  <span class="text-[14.5px] leading-snug text-fg">{p.title}</span>
                  <span class="mt-0.5 flex shrink-0 items-center gap-2 font-mono text-[11.5px] text-muted">
                    {p.venue.replace(/^IEEE(\/ACS)? /, '')} {p.year}
                    <span class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <div class="eyebrow mb-3.5">Open source contributions</div>
        {
          about.openSource.map((o) => (
            <div class="rounded-2xl border border-line p-4">
              <p class="font-serif text-[1.05rem] text-fg">{o.name}</p>
              <p class="mt-1 text-[14px] leading-relaxed text-fg/75">{o.text}</p>
              <div class="mt-2.5 flex gap-5 text-[13px]">
                {o.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class="about-link">
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-link {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 1px;
    transition: border-color 0.2s ease;
  }
  .about-link:hover {
    border-color: var(--color-fg);
  }

  .skill {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    outline: none;
  }
  .skill-tile {
    color: color-mix(in srgb, var(--brand, var(--color-fg)) 78%, var(--color-muted));
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.4s ease;
  }
  .skill:hover .skill-tile,
  .skill:focus-visible .skill-tile {
    transform: translateY(-3px);
    color: var(--brand, var(--color-fg));
    border-color: color-mix(in srgb, var(--brand, var(--color-fg)) 45%, transparent);
    background: color-mix(in srgb, var(--brand, var(--color-fg)) 9%, var(--color-surface));
    box-shadow: 0 12px 28px -14px color-mix(in srgb, var(--brand, #000) 60%, transparent);
  }
  .skill-name {
    position: absolute;
    top: calc(100% + 0.4rem);
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .skill:hover .skill-name,
  .skill:focus-visible .skill-name {
    opacity: 1;
    transform: none;
  }
  /* Touch screens have no hover, so tapping a tile shows its name */
  @media (hover: none) {
    .skill:focus .skill-tile {
      color: var(--brand, var(--color-fg));
    }
    .skill:focus .skill-name {
      opacity: 1;
      transform: none;
    }
  }
</style>
