---
import { site } from '../data/site';

const links = [
  {
    label: 'GitHub',
    href: site.github,
    external: true,
    path: 'M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
  },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    external: true,
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
  },
  {
    label: 'Email',
    href: `mailto:${site.email}`,
    external: false,
    path: '',
  },
];
---

<section id="contact" class="shell pb-20 pt-16 sm:pb-24 sm:pt-24">
  <ul class="flex items-center justify-center gap-5 sm:gap-7">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noopener' : undefined}
            aria-label={l.label}
            class="contact-icon group relative grid size-16 place-items-center rounded-full border border-line bg-surface text-fg/80 sm:size-[4.5rem]"
          >
            {l.path ? (
              <svg viewBox="0 0 24 24" class="size-6 sm:size-7" fill="currentColor" aria-hidden="true">
                <path d={l.path} />
              </svg>
            ) : (
              <svg
                viewBox="0 0 24 24"
                class="size-6 sm:size-7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                <path d="m3.5 6.5 8.5 6 8.5-6" />
              </svg>
            )}
            <span class="contact-tip pointer-events-none absolute top-full mt-3 whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.12em] text-muted">
              {l.label}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

</section>

<style>
  .contact-icon {
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.4s ease;
  }
  .contact-icon:hover,
  .contact-icon:focus-visible {
    transform: translateY(-4px);
    color: var(--color-fg);
    border-color: color-mix(in srgb, var(--color-fg) 30%, transparent);
    background: var(--color-surface2);
    box-shadow: 0 16px 34px -16px rgb(0 0 0 / 0.8);
  }
  .contact-icon:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .contact-tip {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact-icon:hover .contact-tip,
  .contact-icon:focus-visible .contact-tip {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .contact-tip {
      opacity: 1;
      transform: none;
    }
  }
</style>
